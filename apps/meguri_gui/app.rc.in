// Icon and Windows version resource for Meguri.exe.
#include <winres.h>

1 ICON "@MEGURI_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MEGURI_VERSION_COMMA@
PRODUCTVERSION @MEGURI_VERSION_COMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "ProductName", "Meguri"
            VALUE "FileDescription", "Meguri - Animated WebP / MP4 bulk viewer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Meguri.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
