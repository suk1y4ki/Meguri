// アプリアイコン (実行ファイル / タスクバー / ウィンドウ) とバージョン情報
#include <winres.h>

1 ICON "../../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "ProductName", "Meguri"
            VALUE "FileDescription", "Meguri - Animated WebP / MP4 bulk viewer"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Meguri.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
